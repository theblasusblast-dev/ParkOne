# Variables de la API. Copiar este archivo como .env (en esta misma carpeta).
# El .env nunca se sube al repositorio.

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Puerto HTTP donde escucha la API
PORT=4000

# Origen que puede llamar a la API desde el navegador (frontend Angular)
CORS_ORIGIN=http://localhost:4200
