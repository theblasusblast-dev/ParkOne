# Variables de Docker Compose (base de datos local).
# Copiar este archivo como .env y ajustar si hace falta. El .env nunca se sube.

# Usuario, contraseña y nombre de la base de datos de desarrollo
POSTGRES_USER=parkone
POSTGRES_PASSWORD=parkone_dev
POSTGRES_DB=parkone

# Puerto del computador donde se expone PostgreSQL.
# Se usa 5433 para no chocar con otra instalación de PostgreSQL en el 5432.
POSTGRES_PORT=5433

# Secreto con el que la API (en Docker) firma los tokens de sesión: mínimo 32 caracteres.
# Generar uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=reemplaza-esto-por-un-secreto-aleatorio-de-al-menos-32-caracteres
